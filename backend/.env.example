ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
DATABASE_URL=sqlite+aiosqlite:///./workflows.db
CORS_ORIGINS=http://localhost:5173
