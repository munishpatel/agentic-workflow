# Copy this file to `.env`, then edit that copy:
#
#     cp .env.example .env
#
# Nothing here is secret. Every VITE_* variable is baked into the JavaScript
# bundle at build time and is readable by anyone who loads the page, so API
# keys never belong in this file — the Anthropic key lives in `backend/.env`.
#
# Vite reads these only when the dev server starts. After changing anything
# here, stop and restart `npm run dev` or the old values stay in effect.


# ── Where the API comes from ────────────────────────────────────────────────
#
# true  → The app serves its own API from MSW inside the browser, seeded with
#         two demo workflows. No backend, no Python, no API key needed. This is
#         the default so a fresh checkout runs immediately.
#
# false → Talk to the real FastAPI backend. Start it first:
#             cd ../backend && uv run uvicorn app.main:app --reload --port 8000
#
# A "Mock API" badge in the header tells you which mode is live. If you set
# this to false and still see the badge, the dev server needs restarting.
VITE_USE_MOCKS=true


# ── Backend address ─────────────────────────────────────────────────────────
#
# Leave empty. Requests then go to /api, and the dev server proxies them to
# http://localhost:8000 (configured in vite.config.ts).
#
# Set an absolute URL only when the backend is somewhere else — a deployed
# environment, or a container on a different port. Example:
#     VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=
